<Window x:Class="CadenceCisLibraryManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrCAD CIS 智能库与研发物料管控系统" Height="900" Width="1240" MinHeight="760" MinWidth="1040"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
            <MenuItem Header="配置">
                <MenuItem Header="设置" Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" x:Name="MainTabControl">
            <!-- Tab 1: CIS Library Manager (A/B/C swapped) -->
            <TabItem Header=" 🏷️ CIS 零件库建库工作台 ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="170" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Table & PN tools -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="RefreshTablesButton" Width="85" Height="28" VerticalContentAlignment="Center" Margin="0,0,6,0" Click="RefreshTables_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE895;" />
                                    <TextBlock Text="读取表" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="数据库表:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" />
                            <ComboBox x:Name="TableComboBox" Width="200" Height="28" Margin="0,0,8,0" SelectionChanged="TableComboBox_SelectionChanged" />
                            <Button x:Name="LoadColumnsButton" Width="85" Height="28" Margin="0,0,8,0" Click="LoadColumns_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE70F;" />
                                    <TextBlock Text="载入表单" />
                                </StackPanel>
                            </Button>

                            <CheckBox x:Name="chkStandardPartMode" Content="标准料模式 (复用 DISCRETE 符号与标准封装)" VerticalAlignment="Center" Margin="0,0,12,0" Checked="chkStandardPartMode_Checked" Unchecked="chkStandardPartMode_Unchecked" />

                            <Button x:Name="GenerateNumberButton" Width="85" Height="28" Margin="0,0,12,0" Click="GenerateNumber_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE8D2;" />
                                    <TextBlock Text="发号" />
                                </StackPanel>
                            </Button>

                            <TextBlock Text="查询PN:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="PartNumberSearchBox" Width="130" Height="28" Margin="0,0,6,0" />
                            <Button x:Name="FindRecordButton" Width="60" Height="28" Content="查找" Click="FindRecord_Click" />
                        </WrapPanel>
                    </Border>

                    <!-- Area A: Core Workstation & Form (Dynamic Form + Distributor/Note + Association) -->
                    <GroupBox Grid.Row="1" Header="【区域 A】核心入库工作台 (Dynamic Form &amp; Database Workstation)" Margin="0,0,0,8" Padding="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="10" />
                                <ColumnDefinition Width="320" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="FormPanel" />
                            </ScrollViewer>

                            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <GroupBox x:Name="SymbolFilesGroupBox" Header="关联原理图符号" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                        <StackPanel x:Name="SymbolFilesPanel" />
                                    </GroupBox>

                                    <GroupBox x:Name="FootprintFilesGroupBox" Header="关联 PCB 封装" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                        <StackPanel x:Name="FootprintFilesPanel" />
                                    </GroupBox>

                                    <GroupBox x:Name="Model3DFilesGroupBox" Header="关联 3D 模型" Padding="8" Visibility="Collapsed">
                                        <StackPanel x:Name="Model3DFilesPanel" />
                                    </GroupBox>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </GroupBox>

                    <!-- Area B: Online Search & Spec Enricher -->
                    <GroupBox Grid.Row="2" Header="【区域 B】联网搜索与参数注入器 (Online Search &amp; Spec Enricher)" Margin="0,0,0,8" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="120" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Search Input Row -->
                            <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                <TextBlock Text="数据源:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                                <RadioButton x:Name="rbDigiKey" Content="DigiKey (权威参数/EOL审查)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <RadioButton x:Name="rbLcsc" Content="立创商城 / JLCPCB (国内现货/3D)" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <CheckBox x:Name="chkAutoEnrichLcsc" Content="自动级联立创补充 (现货价与LCSC号)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Text="关键字:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="OnlineSearchBox" Width="260" Height="26" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="OnlineSearchBox_KeyDown" ToolTip="输入型号如 LM358DR 或描述如 0402 10k 1%" />
                                <Button x:Name="OnlineSearchButton" Width="80" Height="26" Content="搜索" Click="OnlineSearchButton_Click" />
                            </WrapPanel>

                            <!-- Search Results Grid -->
                            <DataGrid Grid.Row="1" x:Name="SearchResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      SelectionMode="Single" SelectionChanged="SearchResultsGrid_SelectionChanged" Margin="0,0,0,6" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80" />
                                    <DataGridTextColumn Header="原厂型号 (MPN)" Binding="{Binding ManufacturerProductNumber}" Width="150" />
                                    <DataGridTextColumn Header="品牌/厂商" Binding="{Binding Manufacturer}" Width="110" />
                                    <DataGridTextColumn Header="封装规格" Binding="{Binding Package}" Width="100" />
                                    <DataGridTextColumn Header="生命周期 / 状态" Binding="{Binding DisplayStatus}" Width="120" />
                                    <DataGridTextColumn Header="库存" Binding="{Binding Stock}" Width="80" />
                                    <DataGridTextColumn Header="参考价格" Binding="{Binding Price}" Width="80" />
                                    <DataGridTextColumn Header="立创编号" Binding="{Binding LcscPartNumber}" Width="90" />
                                    <DataGridTextColumn Header="品名与电气描述" Binding="{Binding Description}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Action Bar -->
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" x:Name="SelectedResultSummary" Text="请在上方列表中选中物料条目以注入参数。" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" x:Name="ApplyOnlineResultButton" Content="应用并填充至表单" IsEnabled="False" Height="26" Padding="12,0" Click="ApplyOnlineResultButton_Click" />
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <!-- Area C: Asset Intake Zone (Drag & drop or manual pick, swapped from A) -->
                    <GroupBox Grid.Row="3" Header="【区域 C】文件上传与资产处理区 (Asset Intake Zone)" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Drag & Drop container -->
                            <Border Grid.Row="0" BorderBrush="#2563EB" BorderThickness="2" CornerRadius="6" Background="#F8FAFC"
                                    Padding="8" AllowDrop="True" Drop="ArchiveDropZone_Drop" DragOver="ArchiveDropZone_DragOver" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE898;" FontSize="16" Foreground="#2563EB" Margin="0,0,6,0" />
                                            <TextBlock Text="拖拽 UltraLibrarian 23+ / SnapEDA 压缩包至此处，或点击右侧选择" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="IntakeStatusBadge" Text="状态：等待资产包导入（未关联文件）" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="选择 ZIP 压缩包" Height="28" Padding="10,0" Margin="0,0,6,0" Click="BrowseZipArchive_Click" />
                                        <ToggleButton x:Name="ManualFilesToggle" Content="个别文件手动指定" Height="28" Padding="8,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Manual file picker -->
                            <Border Grid.Row="1" Visibility="{Binding IsChecked, ElementName=ManualFilesToggle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6" Background="#FAFAFA">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="封装文件" VerticalAlignment="Center" Margin="0,0,4,4" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="FootprintFilesBox" IsReadOnly="True" Margin="0,0,4,4" ToolTip="Allegro .psm / .dra" />
                                    <Button Grid.Row="0" Grid.Column="2" Click="BrowseFootprintFiles_Click" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                                    </Button>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="源符号库" VerticalAlignment="Center" Margin="0,0,4,4" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SourceSymbolLibraryBox" IsReadOnly="True" Margin="0,0,4,4" ToolTip="源 .olb 符号库" />
                                    <Button Grid.Row="1" Grid.Column="2" Click="BrowseSourceSymbolLibrary_Click" Margin="0,0,8,4">
                                        <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="符号库目录" VerticalAlignment="Center" Margin="0,0,4,4" />
                                    <Button Grid.Row="1" Grid.Column="4" Width="85" Height="24" Click="OpenSymbolLibraryFolders_Click" Margin="0,0,0,4">
                                        <TextBlock Text="打开文件夹" />
                                    </Button>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="3D 模型文件" VerticalAlignment="Center" Margin="0,0,4,4" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="Model3DFileBox" IsReadOnly="True" Margin="0,0,4,4" />
                                    <Button Grid.Row="2" Grid.Column="2" Click="BrowseModel3DFile_Click" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                                    </Button>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="焊盘/引脚文件" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="PinFileBox" IsReadOnly="True" Margin="0,0,4,0" ToolTip="Allegro .pad/.osm/.bsm/.fsm/.ssm" />
                                    <Button Grid.Row="3" Grid.Column="2" Click="BrowsePinFile_Click">
                                        <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- Tab 2: Sample Inventory Management -->
            <TabItem Header=" 📦 研发样品库存管控 ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="240" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="180" />
                    </Grid.RowDefinitions>

                    <!-- Top Filter & Search Bar -->
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="样品检索:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="SampleSearchBox" Width="260" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="SampleSearchBox_KeyDown" ToolTip="输入物料号 (PN)、型号 (MPN)、描述或库位" />
                                <Button Content="查询" Width="70" Height="28" Click="SampleSearch_Click" Margin="0,0,8,0" />
                                <Button Content="全部" Width="60" Height="28" Click="SampleShowAll_Click" Margin="0,0,12,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📥 登记入库" Height="28" Padding="10,0" Margin="0,0,6,0" Click="SampleQuickCheckIn_Click" Background="#DCFCE7" BorderBrush="#86EFAC" FontWeight="SemiBold" />
                                <Button Content="📤 领用/借出" Height="28" Padding="10,0" Margin="0,0,6,0" Click="SampleQuickCheckout_Click" Background="#E0F2FE" BorderBrush="#7DD3FC" FontWeight="SemiBold" />
                                <Button Content="🔄 归还样品" Height="28" Padding="10,0" Margin="0,0,6,0" Click="SampleQuickReturn_Click" />
                                <Button Content="🗑️ 报废核销" Height="28" Padding="10,0" Click="SampleQuickScrap_Click" Foreground="#DC2626" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Sample Inventory Summary Grid -->
                    <GroupBox Grid.Row="1" Header="研发样品库存总览" Margin="0,0,0,8" Padding="6">
                        <DataGrid x:Name="SampleInventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionChanged="SampleInventoryGrid_SelectionChanged" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="物料号 (PN)" Binding="{Binding PartNumber}" Width="120" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="存放库位" Binding="{Binding Location}" Width="120" />
                                <DataGridTextColumn Header="可用库存" Binding="{Binding QuantityOnHand}" Width="80" FontWeight="Bold" Foreground="#16A34A" />
                                <DataGridTextColumn Header="在借调测" Binding="{Binding QuantityLent}" Width="80" Foreground="#EA580C" />
                                <DataGridTextColumn Header="累计入库" Binding="{Binding QuantityTotalIn}" Width="80" />
                                <DataGridTextColumn Header="标称值/规格" Binding="{Binding Value}" Width="100" />
                                <DataGridTextColumn Header="封装" Binding="{Binding Package}" Width="90" />
                                <DataGridTextColumn Header="原厂型号 (MPN)" Binding="{Binding ManufacturerPartNumber}" Width="140" />
                                <DataGridTextColumn Header="厂商" Binding="{Binding Manufacturer}" Width="100" />
                                <DataGridTextColumn Header="分销渠道" Binding="{Binding Distributor}" Width="100" />
                                <DataGridTextColumn Header="说明与描述" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Action Details & Operations Bar -->
                    <Grid Grid.Row="2" Margin="0,0,0,8">
                        <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="当前选定物料:" FontWeight="SemiBold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SelectedSamplePartLabel" Text="未选中" Foreground="#2563EB" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                                    <TextBlock Text="库位:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <ComboBox x:Name="SampleLocationComboBox" Width="140" Height="26" Margin="0,0,12,0" />
                                    <TextBlock Text="经办/领用人:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SampleOperatorBox" Width="90" Height="26" Margin="0,0,12,0" VerticalContentAlignment="Center" />
                                    <TextBlock Text="数量:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SampleQuantityBox" Width="60" Height="26" Margin="0,0,12,0" Text="1" VerticalContentAlignment="Center" />
                                    <TextBlock Text="研发项目/板卡:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SampleProjectBox" Width="110" Height="26" Margin="0,0,12,0" VerticalContentAlignment="Center" ToolTip="如 EVB_V1.0 或 项目代号" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="备注:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SampleRemarkBox" Width="130" Height="26" Margin="0,0,8,0" VerticalContentAlignment="Center" />
                                    <Button Content="执行出入库操作" Height="26" Padding="10,0" Click="ExecuteSampleOperation_Click" Background="#2563EB" Foreground="White" FontWeight="SemiBold" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Sample Transaction History Logs -->
                    <GroupBox Grid.Row="3" Header="物料出入库流水与领用借还履历" Padding="6">
                        <DataGrid x:Name="SampleTransactionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130" />
                                <DataGridTextColumn Header="物料号 (PN)" Binding="{Binding PartNumber}" Width="120" />
                                <DataGridTextColumn Header="业务类型" Binding="{Binding TransactionType}" Width="90" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="变动数量" Binding="{Binding Quantity}" Width="70" FontWeight="Bold" />
                                <DataGridTextColumn Header="经办人/领用人" Binding="{Binding Operator}" Width="100" />
                                <DataGridTextColumn Header="库位" Binding="{Binding Location}" Width="110" />
                                <DataGridTextColumn Header="研发项目/代号" Binding="{Binding ProjectName}" Width="120" />
                                <DataGridTextColumn Header="备注说明" Binding="{Binding Remark}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status & Submit Bar -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" Foreground="#444444" Text="系统就绪。请选择数据表或直接拖入 ZIP 资产包。" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="1" x:Name="SubmitButton" Content="提交入库" Width="120" Height="32" FontWeight="SemiBold" Click="Submit_Click" />
        </Grid>
    </Grid>
</Window>
