<Window x:Class="CadenceCisLibraryManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrCAD CIS 智能库管理器" Height="880" Width="1220" MinHeight="740" MinWidth="1040"
        Loaded="Window_Loaded">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
            <MenuItem Header="配置">
                <MenuItem Header="设置" Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Area A: Asset Intake Zone -->
        <GroupBox Grid.Row="1" Header="【区域 A】资产包导入区 (Asset Intake Zone)" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Drag & Drop container -->
                <Border Grid.Row="0" BorderBrush="#2563EB" BorderThickness="2" CornerRadius="6" Background="#F8FAFC"
                        Padding="12" AllowDrop="True" Drop="ArchiveDropZone_Drop" DragOver="ArchiveDropZone_DragOver" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE898;" FontSize="18" Foreground="#2563EB" Margin="0,0,8,0" />
                                <TextBlock Text="拖拽 UltraLibrarian 23+ / SnapEDA 压缩包至此处，或点击右侧选择" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock x:Name="IntakeStatusBadge" Text="状态：等待资产包导入（未关联文件）" Foreground="#64748B" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="选择 ZIP 压缩包" Height="30" Padding="12,0" Margin="0,0,8,0" Click="BrowseZipArchive_Click" />
                            <ToggleButton x:Name="ManualFilesToggle" Content="个别文件手动指定" Height="30" Padding="10,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Manual file picker -->
                <Border Grid.Row="1" Visibility="{Binding IsChecked, ElementName=ManualFilesToggle, Converter={StaticResource BooleanToVisibilityConverter}}"
                        BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="10" Background="#FAFAFA">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="36" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="封装文件" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="FootprintFilesBox" IsReadOnly="True" Margin="0,0,6,6" ToolTip="Allegro .psm / .dra" />
                        <Button Grid.Row="0" Grid.Column="2" Click="BrowseFootprintFiles_Click" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                        </Button>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="源符号库" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Row="1" Grid.Column="1" x:Name="SourceSymbolLibraryBox" IsReadOnly="True" Margin="0,0,6,6" ToolTip="源 .olb 符号库" />
                        <Button Grid.Row="1" Grid.Column="2" Click="BrowseSourceSymbolLibrary_Click" Margin="0,0,10,6">
                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                        </Button>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="符号库目录" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <Button Grid.Row="1" Grid.Column="4" Width="90" Click="OpenSymbolLibraryFolders_Click" Margin="0,0,0,6">
                            <TextBlock Text="打开文件夹" />
                        </Button>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="3D 模型文件" VerticalAlignment="Center" Margin="0,0,6,6" />
                        <TextBox Grid.Row="2" Grid.Column="1" x:Name="Model3DFileBox" IsReadOnly="True" Margin="0,0,6,6" />
                        <Button Grid.Row="2" Grid.Column="2" Click="BrowseModel3DFile_Click" Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                        </Button>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="焊盘/引脚文件" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Grid.Row="3" Grid.Column="1" x:Name="PinFileBox" IsReadOnly="True" Margin="0,0,6,0" ToolTip="Allegro .pad/.osm/.bsm/.fsm/.ssm" />
                        <Button Grid.Row="3" Grid.Column="2" Click="BrowsePinFile_Click">
                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </GroupBox>

        <!-- Area B: Online Search & Spec Enricher -->
        <GroupBox Grid.Row="2" Header="【区域 B】联网搜索与参数注入器 (Online Search &amp; Spec Enricher)" Margin="0,0,0,10" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="140" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Input Row -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <TextBlock Text="数据源:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                    <RadioButton x:Name="rbDigiKey" Content="DigiKey (权威参数/EOL审查)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <RadioButton x:Name="rbLcsc" Content="立创商城 / JLCPCB (国内现货/3D)" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox x:Name="chkAutoEnrichLcsc" Content="自动级联立创补充 (现货价与LCSC号)" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <TextBlock Text="关键字:" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="OnlineSearchBox" Width="260" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="OnlineSearchBox_KeyDown" ToolTip="输入型号如 LM358DR 或描述如 0402 10k 1%" />
                    <Button x:Name="OnlineSearchButton" Width="80" Height="28" Content="搜索" Click="OnlineSearchButton_Click" />
                </WrapPanel>

                <!-- Search Results Grid -->
                <DataGrid Grid.Row="1" x:Name="SearchResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionChanged="SearchResultsGrid_SelectionChanged" Margin="0,0,0,6" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="80" />
                        <DataGridTextColumn Header="原厂型号 (MPN)" Binding="{Binding ManufacturerProductNumber}" Width="150" />
                        <DataGridTextColumn Header="品牌/厂商" Binding="{Binding Manufacturer}" Width="110" />
                        <DataGridTextColumn Header="封装规格" Binding="{Binding Package}" Width="100" />
                        <DataGridTextColumn Header="生命周期 / 状态" Binding="{Binding DisplayStatus}" Width="120" />
                        <DataGridTextColumn Header="库存" Binding="{Binding Stock}" Width="80" />
                        <DataGridTextColumn Header="参考价格" Binding="{Binding Price}" Width="80" />
                        <DataGridTextColumn Header="立创编号" Binding="{Binding LcscPartNumber}" Width="90" />
                        <DataGridTextColumn Header="品名与电气描述" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Action Bar -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="SelectedResultSummary" Text="请在上方列表中选中物料条目以注入参数。" Foreground="#64748B" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" x:Name="ApplyOnlineResultButton" Content="应用并填充至表单" IsEnabled="False" Height="28" Padding="12,0" Click="ApplyOnlineResultButton_Click" />
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Area C: Core Workstation & Form -->
        <GroupBox Grid.Row="3" Header="【区域 C】核心入库工作台 (Dynamic Form &amp; Database Workstation)" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Table Selector & Part Number Generator -->
                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
                    <Button x:Name="RefreshTablesButton" Width="85" Height="28" VerticalContentAlignment="Center" Margin="0,0,6,0" Click="RefreshTables_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE895;" />
                            <TextBlock Text="读取表" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="数据库表" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="TableComboBox" Width="200" Height="28" Margin="0,0,8,0" SelectionChanged="TableComboBox_SelectionChanged" />
                    <Button x:Name="LoadColumnsButton" Width="85" Height="28" Margin="0,0,8,0" Click="LoadColumns_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE70F;" />
                            <TextBlock Text="表单" />
                        </StackPanel>
                    </Button>

                    <CheckBox x:Name="chkStandardPartMode" Content="标准料模式 (复用 DISCRETE 符号与标准封装)" VerticalAlignment="Center" Margin="0,0,12,0" Checked="chkStandardPartMode_Checked" Unchecked="chkStandardPartMode_Unchecked" />

                    <Button x:Name="GenerateNumberButton" Width="85" Height="28" Margin="0,0,12,0" Click="GenerateNumber_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE8D2;" />
                            <TextBlock Text="发号" />
                        </StackPanel>
                    </Button>

                    <TextBlock Text="查询PN:" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="PartNumberSearchBox" Width="140" Height="28" Margin="0,0,6,0" />
                    <Button x:Name="FindRecordButton" Width="60" Height="28" Content="查找" Click="FindRecord_Click" />
                </WrapPanel>

                <!-- Form Panel and File Association -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="FormPanel" />
                    </ScrollViewer>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <GroupBox x:Name="SymbolFilesGroupBox" Header="关联原理图符号" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                <StackPanel x:Name="SymbolFilesPanel" />
                            </GroupBox>

                            <GroupBox x:Name="FootprintFilesGroupBox" Header="关联 PCB 封装" Padding="8" Margin="0,0,0,8" Visibility="Collapsed">
                                <StackPanel x:Name="FootprintFilesPanel" />
                            </GroupBox>

                            <GroupBox x:Name="Model3DFilesGroupBox" Header="关联 3D 模型" Padding="8" Visibility="Collapsed">
                                <StackPanel x:Name="Model3DFilesPanel" />
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </GroupBox>

        <!-- Status & Submit Bar -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" Foreground="#444444" Text="系统就绪。请选择数据表或直接拖入 ZIP 资产包。" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="1" x:Name="SubmitButton" Content="提交入库" Width="120" Height="34" FontWeight="SemiBold" Click="Submit_Click" />
        </Grid>
    </Grid>
</Window>
