<Window x:Class="CadenceCisLibraryManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OrCAD CIS 智能库与研发物料管控系统" Height="920" Width="1280" MinHeight="780" MinWidth="1060"
        Loaded="Window_Loaded">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Menu -->
        <Menu Grid.Row="0" Margin="0,0,0,8" VerticalAlignment="Center">
            <MenuItem Header="配置">
                <MenuItem Header="设置" Click="Settings_Click" />
            </MenuItem>
            <MenuItem Header="帮助">
                <MenuItem Header="关于" Click="About_Click" />
            </MenuItem>
        </Menu>

        <!-- Main TabControl -->
        <TabControl Grid.Row="1" x:Name="MainTabControl">
            <!-- ========================================================= -->
            <!-- Tab 1: 料号管理 (Part Number Management)                   -->
            <!-- ========================================================= -->
            <TabItem Header=" 🔖 料号管理 ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.8*" MinHeight="170" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="3*" MinHeight="260" />
                    </Grid.RowDefinitions>

                    <!-- Top Bar: Query & Global Part Operations -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📋 查看全部料号" Height="28" Padding="12,0" Margin="0,0,10,0" FontWeight="SemiBold" Background="#EFF6FF" BorderBrush="#93C5FD" Click="ShowAllComponents_Click" ToolTip="从全库跨表汇总视图载入所有料号数据" />
                                <TextBlock Text="跨表全局检索:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                                <TextBox x:Name="ComponentSearchBox" Width="240" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="ComponentSearchBox_KeyDown" ToolTip="输入公司料号(PN)、原厂型号(MPN)、阻容规格、厂商或描述" />
                                <Button Content="查询" Width="65" Height="28" Click="ComponentSearch_Click" Background="#2563EB" Foreground="White" Margin="0,0,10,0" />
                                <Button Content="📊 导出列表 (CSV)" Height="28" Padding="10,0" Click="ExportComponentsCsv_Click" ToolTip="将当前列表导出的 CSV 文件带 UTF-8 BOM，支持 Excel 双击直接打开" Margin="0,0,10,0" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="➕ 新增料号 (无图档先行建号)" Height="28" Padding="12,0" FontWeight="Bold" Background="#16A34A" Foreground="White" Click="NewComponent_Click" ToolTip="切换至新增料号模式，自动发号并允许在没有图档时先行建号入库" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: All Components Grid -->
                    <GroupBox Grid.Row="1" Header="全库料号总览与跨表清单 (单击行载入下方表单，双击在【CIS图档维护】中定位)" Margin="0,0,0,4" Padding="6">
                        <DataGrid x:Name="AllComponentsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionChanged="AllComponentsGrid_SelectionChanged" MouseDoubleClick="AllComponentsGrid_MouseDoubleClick"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分类/所属表" Binding="{Binding Category}" Width="125" />
                                <DataGridTextColumn Header="公司料号 (PN)" Binding="{Binding PartNumber}" Width="125" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="规格 / 值" Binding="{Binding Value}" Width="100" />
                                <DataGridTextColumn Header="封装" Binding="{Binding Package}" Width="90" />
                                <DataGridTextColumn Header="原厂型号 (MPN)" Binding="{Binding ManufacturerPartNumber}" Width="150" />
                                <DataGridTextColumn Header="厂商" Binding="{Binding Manufacturer}" Width="100" />
                                <DataGridTextColumn Header="规格书 (Datasheet)" Binding="{Binding Datasheet}" Width="130" />
                                <DataGridTextColumn Header="渠道/渠道商" Binding="{Binding Distributor}" Width="100" />
                                <DataGridTextColumn Header="图档状态" Binding="{Binding DrawingStatus}" Width="90" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="品名与描述" Binding="{Binding Description}" Width="*" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="100" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#E2E8F0" />

                    <!-- Row 3: Lower Section (Area A Form + Area B Online Search) -->
                    <Grid Grid.Row="3" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.1*" MinWidth="380" />
                            <ColumnDefinition Width="5" />
                            <ColumnDefinition Width="*" MinWidth="360" />
                        </Grid.ColumnDefinitions>

                        <!-- Area A: Core Dynamic Form -->
                        <GroupBox Grid.Column="0" Header="【区域 A】料号参数录入工作台 (Dynamic Spec Workstation)" Margin="0,0,4,0" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Table and Fast PN Header -->
                                <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="4" Padding="6" Margin="0,0,0,6">
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="分类表:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="SemiBold" />
                                        <ComboBox x:Name="TableComboBox" Width="145" Height="26" Margin="0,0,6,0" SelectionChanged="TableComboBox_SelectionChanged" />
                                        <Button x:Name="LoadColumnsButton" Content="载入表单" Height="26" Padding="6,0" Margin="0,0,6,0" Click="LoadColumns_Click" />
                                        <Button x:Name="GenerateNumberButton" Content="⚡ 自动发号" Height="26" Padding="6,0" Margin="0,0,6,0" Click="GenerateNumber_Click" FontWeight="SemiBold" />
                                        <CheckBox x:Name="chkStandardPartMode" Content="标准件" VerticalAlignment="Center" Margin="0,0,6,0" Checked="chkStandardPartMode_Checked" Unchecked="chkStandardPartMode_Unchecked" ToolTip="复用 DISCRETE 符号与标准封装" />
                                        <Button Content="🔄 刷新物理库缓存" Height="26" Padding="6,0" Margin="4,0,0,0" Click="RefreshLibraryCache_Click" ToolTip="重新扫描 SMB 共享库中现有的 Allegro 封装与 3D 模型" />
                                    </WrapPanel>
                                </Border>

                                <!-- Dynamic Form Controls -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="FormPanel" />
                                </ScrollViewer>

                                <!-- Action Buttons -->
                                <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="0,6,0,0" Margin="0,4,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" x:Name="FormEditingHint" Text="提示：图档字段可留空，先建号即可在样品库中入库管理" Foreground="#64748B" VerticalAlignment="Center" FontSize="11" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="清空重置" Height="30" Padding="10,0" Margin="0,0,8,0" Click="ResetForm_Click" />
                                            <Button x:Name="SaveComponentButton" Content="💾 保存料号至数据库" Height="30" Padding="14,0" FontWeight="Bold" Background="#2563EB" Foreground="White" Click="SaveComponent_Click" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </GroupBox>

                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="#E2E8F0" />

                        <!-- Area B: Online Search & Spec Enricher -->
                        <GroupBox Grid.Column="2" Header="【区域 B】联网搜索与参数注入器 (3 模式搜索与文档下载)" Margin="4,0,0,0" Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Search Modes: 3-mode selection -->
                                <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                    <TextBlock Text="模式:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                                    <RadioButton x:Name="rbSearchCombined" Content="🌐 联合搜索 (DigiKey+立创)" GroupName="SearchMode" IsChecked="True" VerticalAlignment="Center" Margin="0,0,10,0" FontWeight="SemiBold" ToolTip="同时检索两方供应链，自动聚合库存与立创编号" />
                                    <RadioButton x:Name="rbSearchDigiKey" Content="🔍 仅 DigiKey" GroupName="SearchMode" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <RadioButton x:Name="rbSearchLcsc" Content="🛒 仅立创 / JLCPCB" GroupName="SearchMode" VerticalAlignment="Center" Margin="0,0,6,0" />
                                </WrapPanel>

                                <!-- Search Input Bar -->
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="关键字:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBox Grid.Column="1" x:Name="OnlineSearchBox" Height="26" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="OnlineSearchBox_KeyDown" ToolTip="输入型号如 12402076E512A, LM358DR 或描述如 0402 10k" />
                                    <Button Grid.Column="2" x:Name="OnlineSearchButton" Width="70" Height="26" Content="搜索" Click="OnlineSearchButton_Click" Background="#0284C7" Foreground="White" />
                                </Grid>

                                <!-- Results DataGrid -->
                                <DataGrid Grid.Row="2" x:Name="SearchResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          SelectionMode="Single" SelectionChanged="SearchResultsGrid_SelectionChanged" Margin="0,0,0,6" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="95" />
                                        <DataGridTextColumn Header="原厂型号 (MPN)" Binding="{Binding ManufacturerProductNumber}" Width="130" />
                                        <DataGridTextColumn Header="厂商" Binding="{Binding Manufacturer}" Width="95" />
                                        <DataGridTextColumn Header="封装" Binding="{Binding Package}" Width="80" />
                                        <DataGridTextColumn Header="状态" Binding="{Binding DisplayStatus}" Width="85" />
                                        <DataGridTextColumn Header="库存" Binding="{Binding Stock}" Width="65" />
                                        <DataGridTextColumn Header="参考价" Binding="{Binding Price}" Width="75" />
                                        <DataGridTextColumn Header="立创编号" Binding="{Binding LcscPartNumber}" Width="80" />
                                        <DataGridTextColumn Header="品名与描述" Binding="{Binding Description}" Width="*" />
                                    </DataGrid.Columns>
                                </DataGrid>

                                <!-- Injection Controls & Datasheet Option -->
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock x:Name="SelectedResultSummary" Text="请在上方列表中选中条目以注入参数。" Foreground="#64748B" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,0,0,2" />
                                        <CheckBox x:Name="chkAutoDownloadDatasheet" Content="📥 自动下载规格书 (Datasheet) 至 SMB 库并回写文档路径" IsChecked="True" FontSize="11" Foreground="#047857" />
                                    </StackPanel>
                                    <Button Grid.Column="1" x:Name="ApplyOnlineResultButton" Content="注入并填充至表单" IsEnabled="False" Height="28" Padding="12,0" FontWeight="SemiBold" Click="ApplyOnlineResultButton_Click" />
                                </Grid>
                            </Grid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================= -->
            <!-- Tab 2: CIS 图档维护 (CIS Drawing & Footprint Maintenance)  -->
            <!-- ========================================================= -->
            <TabItem Header=" 📐 CIS 图档维护 ">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.4*" MinHeight="140" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="2*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top Filter Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="目标物料查找:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                                <TextBox x:Name="DrawingSearchBox" Width="220" Height="26" VerticalContentAlignment="Center" Margin="0,0,6,0" KeyDown="DrawingSearchBox_KeyDown" ToolTip="输入料号、原厂型号或描述" />
                                <Button Content="查询" Width="60" Height="26" Margin="0,0,8,0" Click="DrawingSearch_Click" />
                                <Button Content="刷新物料" Height="26" Padding="8,0" Margin="0,0,8,0" Click="DrawingRefresh_Click" />
                                <Button Content="🔄 刷新物理库缓存" Height="26" Padding="8,0" Margin="0,0,12,0" Click="RefreshLibraryCache_Click" ToolTip="重新扫描 SMB 共享库中现有的 Allegro 封装与 3D 模型" />
                                <CheckBox x:Name="chkOnlyMissingDrawings" Content="仅显示待补图档物料" VerticalAlignment="Center" Checked="DrawingFilter_Changed" Unchecked="DrawingFilter_Changed" />
                            </StackPanel>

                            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="10,4">
                                <TextBlock x:Name="SelectedDrawingPartInfo" Text="当前选定物料: 未选定 (请在下方列表点击选中目标物料)" FontWeight="Bold" Foreground="#1D4ED8" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Row 1: Drawings Target Grid -->
                    <GroupBox Grid.Row="1" Header="全库物料图档关联状态 (点击行选定需要补齐或维护图档的物料)" Margin="0,0,0,4" Padding="6">
                        <DataGrid x:Name="DrawingsTargetGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionChanged="DrawingsTargetGrid_SelectionChanged"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="分类" Binding="{Binding Category}" Width="120" />
                                <DataGridTextColumn Header="物料号 (PN)" Binding="{Binding PartNumber}" Width="125" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="规格/值" Binding="{Binding Value}" Width="100" />
                                <DataGridTextColumn Header="封装" Binding="{Binding Package}" Width="90" />
                                <DataGridTextColumn Header="原厂型号 (MPN)" Binding="{Binding ManufacturerPartNumber}" Width="140" />
                                <DataGridTextColumn Header="图档就绪状态" Binding="{Binding DrawingStatus}" Width="100" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="原理图符号 (Schematic_Part)" Binding="{Binding SchematicPart}" Width="160" />
                                <DataGridTextColumn Header="PCB封装 (PCB_Footprint)" Binding="{Binding PcbFootprint}" Width="150" />
                                <DataGridTextColumn Header="3D模型 (Model_3D)" Binding="{Binding Model3D}" Width="140" />
                                <DataGridTextColumn Header="品名与描述" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#E2E8F0" />

                    <!-- Row 3: Asset Intake Zone (Former Area C) -->
                    <GroupBox Grid.Row="3" Header="【区域 C】文件上传与资产处理区 (Asset Intake Zone - 拖拽解析与分发入库)" Margin="0,4,0,6" Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderBrush="#2563EB" BorderThickness="2" CornerRadius="6" Background="#F8FAFC"
                                    Padding="8" AllowDrop="True" Drop="ArchiveDropZone_Drop" DragOver="ArchiveDropZone_DragOver" Margin="0,0,0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                            <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE898;" FontSize="16" Foreground="#2563EB" Margin="0,0,6,0" />
                                            <TextBlock Text="拖拽 UltraLibrarian 23+ / SnapEDA 压缩包至此处，或点击右侧选择" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock x:Name="IntakeStatusBadge" Text="状态：等待资产包导入（未关联文件）" Foreground="#64748B" FontSize="11" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="选择 ZIP 压缩包" Height="28" Padding="10,0" Margin="0,0,6,0" Click="BrowseZipArchive_Click" />
                                        <ToggleButton x:Name="ManualFilesToggle" Content="个别文件手动指定" Height="28" Padding="8,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Visibility="{Binding IsChecked, ElementName=ManualFilesToggle, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6" Background="#FAFAFA">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="封装文件" VerticalAlignment="Center" Margin="0,0,4,4" />
                                    <TextBox Grid.Row="0" Grid.Column="1" x:Name="FootprintFilesBox" IsReadOnly="True" Margin="0,0,4,4" ToolTip="Allegro .psm / .dra" />
                                    <Button Grid.Row="0" Grid.Column="2" Click="BrowseFootprintFiles_Click" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                                    </Button>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="源符号库" VerticalAlignment="Center" Margin="0,0,4,4" />
                                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="SourceSymbolLibraryBox" IsReadOnly="True" Margin="0,0,4,4" ToolTip="源 .olb 符号库" />
                                    <Button Grid.Row="1" Grid.Column="2" Click="BrowseSourceSymbolLibrary_Click" Margin="0,0,8,4">
                                        <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                                    </Button>
                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="符号库目录" VerticalAlignment="Center" Margin="0,0,4,4" />
                                    <Button Grid.Row="1" Grid.Column="4" Width="85" Height="24" Click="OpenSymbolLibraryFolders_Click" Margin="0,0,0,4">
                                        <TextBlock Text="打开文件夹" />
                                    </Button>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="3D 模型文件" VerticalAlignment="Center" Margin="0,0,4,4" />
                                    <TextBox Grid.Row="2" Grid.Column="1" x:Name="Model3DFileBox" IsReadOnly="True" Margin="0,0,4,4" />
                                    <Button Grid.Row="2" Grid.Column="2" Click="BrowseModel3DFile_Click" Margin="0,0,0,4">
                                        <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                                    </Button>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="焊盘/引脚文件" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBox Grid.Row="3" Grid.Column="1" x:Name="PinFileBox" IsReadOnly="True" Margin="0,0,4,0" ToolTip="Allegro .pad/.osm/.bsm/.fsm/.ssm" />
                                    <Button Grid.Row="3" Grid.Column="2" Click="BrowsePinFile_Click">
                                        <TextBlock Style="{StaticResource SymbolTextStyle}" Text="&#xE712;" Margin="0" HorizontalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </GroupBox>

                    <!-- Row 4: Submit Bar for Drawings -->
                    <Grid Grid.Row="4" Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="在上方选定物料并上传完封装/符号/3D模型后，点击右侧提交将图档拷贝至 SMB 共享库并更新物料记录。" Foreground="#64748B" VerticalAlignment="Center" />
                        <Button Grid.Column="1" x:Name="SubmitDrawingsButton" Content="💾 提交并更新物料图档至 CIS &amp; SMB 库" Width="260" Height="34" FontWeight="SemiBold" Background="#2563EB" Foreground="White" Click="SubmitDrawings_Click" />
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================================= -->
            <!-- Tab 3: 样品库存管理 (Sample Inventory Management)          -->
            <!-- ========================================================= -->
            <TabItem Header=" 📦 样品库存管理 ">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" MinHeight="230" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="170" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Top Mode & Filter Bar -->
                    <Border Grid.Row="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="📋 查看全部样品库存" Height="28" Padding="12,0" Margin="0,0,16,0" Click="SampleShowAll_Click" FontWeight="SemiBold" Background="#F8FAFC" BorderBrush="#94A3B8" ToolTip="点击载入或刷新全部样品的库存总览清单" />
                                <TextBlock Text="按料号/型号精确检索:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#475569" />
                                <TextBox x:Name="SampleSearchBox" Width="260" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0" KeyDown="SampleSearchBox_KeyDown" ToolTip="输入公司料号 (PN)、原厂型号 (MPN)、描述或库位" />
                                <Button Content="查询" Width="70" Height="28" Click="SampleSearch_Click" Background="#2563EB" Foreground="White" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="💡 提示：在下方列表点击选中目标物料，并在操作栏直接执行出入库" Foreground="#64748B" VerticalAlignment="Center" FontStyle="Italic" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 1: Sample Inventory Summary Grid -->
                    <GroupBox Grid.Row="1" Header="研发样品库存总览 (双击或单击选中物料)" Margin="0,0,0,8" Padding="6">
                        <DataGrid x:Name="SampleInventoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  SelectionMode="Single" SelectionChanged="SampleInventoryGrid_SelectionChanged" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="物料号 (PN)" Binding="{Binding PartNumber}" Width="120" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="存放库位" Binding="{Binding Location}" Width="120" />
                                <DataGridTextColumn Header="可用库存" Binding="{Binding QuantityOnHand}" Width="80" FontWeight="Bold" Foreground="#16A34A" />
                                <DataGridTextColumn Header="在借调测" Binding="{Binding QuantityLent}" Width="80" Foreground="#EA580C" />
                                <DataGridTextColumn Header="累计入库" Binding="{Binding QuantityTotalIn}" Width="80" />
                                <DataGridTextColumn Header="标称值/规格" Binding="{Binding Value}" Width="100" />
                                <DataGridTextColumn Header="封装" Binding="{Binding Package}" Width="90" />
                                <DataGridTextColumn Header="原厂型号 (MPN)" Binding="{Binding ManufacturerPartNumber}" Width="140" />
                                <DataGridTextColumn Header="厂商" Binding="{Binding Manufacturer}" Width="100" />
                                <DataGridTextColumn Header="分销渠道" Binding="{Binding Distributor}" Width="100" />
                                <DataGridTextColumn Header="说明与描述" Binding="{Binding Description}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <!-- Row 2: Operation Bar with Explicit Radio Action Selection -->
                    <GroupBox Grid.Row="2" Header="样品出入库变动操作" Margin="0,0,0,8" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10" VerticalAlignment="Center">
                                <TextBlock Text="当前选定物料:" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,20,0">
                                    <TextBlock x:Name="SelectedSamplePartLabel" Text="未选中（请先在上方列表点选物料）" Foreground="#1D4ED8" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Border>

                                <TextBlock Text="变动业务类型:" FontWeight="Bold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <RadioButton x:Name="rbOpCheckIn" Content="📥 登记入库" GroupName="SampleOp" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="SemiBold" Checked="SampleOperationType_Changed" />
                                <RadioButton x:Name="rbOpConsume" Content="📤 领用消耗 (贴片消耗不归还)" GroupName="SampleOp" VerticalAlignment="Center" Margin="0,0,12,0" Checked="SampleOperationType_Changed" />
                                <RadioButton x:Name="rbOpBorrow" Content="⏱️ 调测借出 (研发借调需归还)" GroupName="SampleOp" VerticalAlignment="Center" Margin="0,0,12,0" Checked="SampleOperationType_Changed" />
                                <RadioButton x:Name="rbOpReturn" Content="🔄 样品归还 (在借样品还回)" GroupName="SampleOp" VerticalAlignment="Center" Margin="0,0,12,0" Checked="SampleOperationType_Changed" />
                                <RadioButton x:Name="rbOpScrap" Content="🗑️ 损坏报废" GroupName="SampleOp" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#DC2626" Checked="SampleOperationType_Changed" />
                            </StackPanel>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="库位:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <ComboBox x:Name="SampleLocationComboBox" Width="140" Height="28" Margin="0,0,12,0" />

                                    <TextBlock Text="变动数量:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SampleQuantityBox" Width="60" Height="28" Margin="0,0,12,0" Text="1" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" FontWeight="Bold" />

                                    <TextBlock Text="经办/领用人:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SampleOperatorBox" Width="90" Height="28" Margin="0,0,12,0" VerticalContentAlignment="Center" ToolTip="工程师姓名" />

                                    <TextBlock Text="研发项目/板卡:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SampleProjectBox" Width="130" Height="28" Margin="0,0,12,0" VerticalContentAlignment="Center" ToolTip="如 EVB_V1.0 或 项目代号 (领用/借出必填)" />

                                    <TextBlock Text="备注说明:" Margin="0,0,4,0" VerticalAlignment="Center" />
                                    <TextBox x:Name="SampleRemarkBox" Width="160" Height="28" Margin="0,0,12,0" VerticalContentAlignment="Center" ToolTip="样品来源、批次或损坏原因说明" />
                                </WrapPanel>

                                <Button Grid.Column="2" x:Name="BtnExecuteSample" Content="确认执行此操作" Width="130" Height="30" Padding="10,0" Click="ExecuteSampleOperation_Click" Background="#2563EB" Foreground="White" FontWeight="Bold" />
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <!-- Row 3: Sample Transaction History Logs -->
                    <GroupBox Grid.Row="3" Header="物料出入库流水与领用借还履历 (按时间倒序)" Padding="6">
                        <DataGrid x:Name="SampleTransactionsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间" Binding="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="130" />
                                <DataGridTextColumn Header="物料号 (PN)" Binding="{Binding PartNumber}" Width="120" />
                                <DataGridTextColumn Header="业务类型" Binding="{Binding TransactionType}" Width="90" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="变动数量" Binding="{Binding Quantity}" Width="70" FontWeight="Bold" />
                                <DataGridTextColumn Header="经办人/领用人" Binding="{Binding Operator}" Width="100" />
                                <DataGridTextColumn Header="库位" Binding="{Binding Location}" Width="110" />
                                <DataGridTextColumn Header="研发项目/代号" Binding="{Binding ProjectName}" Width="120" />
                                <DataGridTextColumn Header="备注说明" Binding="{Binding Remark}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Global Status Bar (Bottom) -->
        <Grid Grid.Row="2" Margin="0,6,0,0">
            <TextBlock x:Name="StatusText" Foreground="#444444" Text="系统就绪。" TextWrapping="Wrap" VerticalAlignment="Center" Margin="4,0,0,0" />
        </Grid>
    </Grid>
</Window>
